# Proxmox VE API ulanish sozlamalari
proxmox_api_url          = "https://192.168.1.100:8006/api2/json"
proxmox_api_token_id     = "terraform-user@pam!my-token"
proxmox_api_token_secret = "00000000-0000-0000-0000-000000000000"
proxmox_tls_insecure     = true

# Target Node va Shablon
target_node   = "pve"
template_name = "ubuntu-2404-tpl"

# VM parametrlari
vm_name      = "ubuntu-static-vm"
vm_cores     = 2
vm_memory    = 2048
vm_disk_size = "32G"
storage_pool = "local-lvm"

# Tarmoq sozlamalari (Statik IP va Gateway)
network_bridge = "wan_br"
vm_ip_cidr     = "192.168.1.150/24"
vm_gateway     = "192.168.1.1"
vm_nameserver  = "1.1.1.1 8.8.8.8"

# Cloud-Init foydalanuvchi va SSH kalit
ci_user        = "ubuntu"
ci_password    = "KuchliParol123!"
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2E... sizning-kalitingiz@host"
